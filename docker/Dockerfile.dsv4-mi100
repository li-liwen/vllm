# syntax=docker/dockerfile:1.6
#
# Build context: this fork (vllm-project/vllm @ dsv4_adapt_mi100).
# Invocation (from project root):
#   cd vllm
#   docker build -f docker/Dockerfile.dsv4-mi100 \
#                -t vllm-rocm-gfx908-dsv4:latest .
#
# What this image is
# ------------------
# A reproducible vLLM build for serving DeepSeek-V4-Flash on 8x MI100
# (gfx908). Weights are kept in their native FP4+FP8 mixed precision in
# VRAM and dequantized inside the Triton kernels added in this fork
# (see vllm/model_executor/layers/quantization/gfx908/...).
#
# Stages
# ------
#  1. base       : ROCm + Python + uv.
#  2. build_vllm : install torch / Triton and this vLLM fork so dispatch hits
#                  the gfx908 kernels.
#  3. runtime    : runnable server layer with the built Python environment.
#
# Notes
# -----
# * PYTORCH_ROCM_ARCH=gfx908 is set as ENV before any pip install so
#   torch / Triton extensions compile only the gfx908 code object.
# * We pin ROCM_BASE for the runtime stage to the same image used in
#   the build stages — version mismatches cause silent JIT failures
#   at first inference (agents.md §12 pitfall #1).
# * AITER is intentionally NOT built here. The MI100 reference Dockerfile
#   skips AITER because current AITER wheels do not support gfx908. DSv4
#   FP8/FP4 work is routed through the Triton kernels in this branch.
# * tilelang is intentionally NOT installed: the gfx908 dispatch path
#   is Triton-only (D5).

ARG ROCM_BASE=rocm/dev-ubuntu-22.04:7.2.1-complete
ARG PYTHON_VERSION=3.12

# =====================================================================
# Stage 1 — base
# =====================================================================
FROM ${ROCM_BASE} AS base

ARG PYTHON_VERSION
ENV PYTHON_VERSION=${PYTHON_VERSION}

ENV PATH=/opt/rocm/llvm/bin:/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV ROCM_PATH=/opt/rocm
ENV LD_LIBRARY_PATH=/opt/rocm/lib:/usr/local/lib:
ENV PYTORCH_ROCM_ARCH=gfx908
ENV HSA_NO_SCRATCH_RECLAIM=1
ENV DEBIAN_FRONTEND=noninteractive
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY=unsafe-best-match
ENV UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
       software-properties-common git curl ca-certificates \
       libgfortran5 build-essential libopenmpi-dev libpci-dev \
       libjpeg-dev libsox-dev libsox-fmt-all sox \
    && for i in 1 2 3; do \
        add-apt-repository -y ppa:deadsnakes/ppa && break || \
        { echo "Attempt $i failed, retrying"; sleep 5; }; \
    done \
    && apt-get update -y \
    && apt-get install -y --no-install-recommends \
       python${PYTHON_VERSION} python${PYTHON_VERSION}-dev \
       python${PYTHON_VERSION}-venv python-is-python3 \
    && update-alternatives --install /usr/bin/python3 python3 \
        /usr/bin/python${PYTHON_VERSION} 1 \
    && update-alternatives --set python3 /usr/bin/python${PYTHON_VERSION} \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python${PYTHON_VERSION} \
    && curl -LsSf https://astral.sh/uv/install.sh \
       | env UV_INSTALL_DIR=/usr/local/bin sh \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -U \
       packaging "cmake<4" ninja wheel "setuptools<80" pybind11 Cython

# =====================================================================
# Stage 2 - vLLM (this fork) install
# =====================================================================
FROM base AS build_vllm

# Install torch + Triton before vLLM so setup.py does not pull CUDA wheels.
# TODO(milestone2): replace these bootstrap wheels with the exact gfx908
# torch/Triton wheel chain used by reference/Dockerfile.mi100_base.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir \
        torch==2.9.1 \
        --index-url https://download.pytorch.org/whl/rocm6.2

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir triton==3.4.0 pyyaml

WORKDIR /app/vllm
COPY . /app/vllm

# Editable install so the in-tree gfx908 kernels are imported as part
# of the vllm package without an extra COPY into site-packages.
RUN --mount=type=cache,target=/root/.cache/pip \
    PYTORCH_ROCM_ARCH=gfx908 \
    VLLM_TARGET_DEVICE=rocm \
    pip install --no-cache-dir -e . --no-build-isolation

# =====================================================================
# Stage 3 - runtime
# =====================================================================
FROM base AS runtime

ARG PYTHON_VERSION
ENV PYTHON_VERSION=${PYTHON_VERSION}
ENV PATH=/opt/rocm/llvm/bin:/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV ROCM_PATH=/opt/rocm
ENV LD_LIBRARY_PATH=/opt/rocm/lib:/usr/local/lib:
ENV PYTORCH_ROCM_ARCH=gfx908
ENV HSA_NO_SCRATCH_RECLAIM=1

# Runtime knobs aligned with agents.md §12 pitfalls 1, 2, 3:
ENV PYTHONHASHSEED=0
ENV PYTORCH_HIP_ALLOC_CONF=expandable_segments:True
ENV VLLM_DSV4_GFX908=1
ENV VLLM_MI100_TORCH_COMPILE=1
ENV VLLM_ROCM_USE_AITER=0
ENV VLLM_ROCM_USE_AITER_LINEAR=0
ENV VLLM_ROCM_USE_AITER_MOE=0
ENV VLLM_ROCM_USE_AITER_MHA=0
ENV VLLM_ROCM_USE_AITER_MLA=0
ENV VLLM_ROCM_USE_AITER_RMSNORM=0
ENV VLLM_ROCM_USE_AITER_FP8BMM=0
ENV VLLM_ROCM_USE_AITER_FP4BMM=0
ENV VLLM_ROCM_USE_AITER_FP4_ASM_GEMM=0
ENV VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=0
ENV TOKENIZERS_PARALLELISM=false
ENV SAFETENSORS_FAST_GPU=1
ENV HIP_FORCE_DEV_KERNARG=1
# Default to the safe attention backend (Triton FA); AITER Unified
# Attention corrupts model state on gfx908 after sustained traffic
# (agents.md §1.5).
ENV VLLM_ATTENTION_BACKEND=TRITON_ATTN

# Bring over the built python environment + the editable vllm tree. The
# runtime stage inherits from ``base`` so /usr/bin/python3.12 and the OS
# libraries installed there are present.
COPY --from=build_vllm /usr/local/lib/python${PYTHON_VERSION} /usr/local/lib/python${PYTHON_VERSION}
COPY --from=build_vllm /usr/local/bin /usr/local/bin
COPY --from=build_vllm /app/vllm /app/vllm

COPY docker/entrypoint.sh /usr/local/bin/dsv4-mi100-entrypoint
RUN chmod +x /usr/local/bin/dsv4-mi100-entrypoint

WORKDIR /app/vllm
ENTRYPOINT ["/usr/local/bin/dsv4-mi100-entrypoint"]
CMD ["--help"]
